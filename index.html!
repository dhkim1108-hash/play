// 전역 다마고치 시스템 상태 정의
const gameState = {
name: "모찌",
type: "jungli",
emoji: "🐹",
gold: 300,
hunger: 100,
happy: 100,
isSick: false,
wheelLevel: 1,
houseLevel: 1,
ownedHats: [],
equippedHat: null,
normalEmoji: "🐹"
};
const wheelData = {
1: { name: "플라스틱 쳇바퀴", emoji: "🎡", gold: 1, style: "" },
2: { name: "무소음 원목 쳇바퀴", emoji: "🎡", gold: 3, style: "filter: sepia(0.6) saturate(1.6);" },
3: { name: "에메랄드 러너 쳇바퀴", emoji: "🎡", gold: 8, style: "filter: hue-rotate(130deg) saturate(2.5);" },
4: { name: "은하수 모터 쳇바퀴", emoji: "🎡", gold: 22, style: "filter: drop-shadow(0 0 8px gold) brightness(1.3);" }
};
const houseData = {
1: { name: "소박한 골판지 상자", emoji: "📦", bg: "linear-gradient(135deg, #e0f2fe, #bae6fd)", floor: "#e2e8f0" },
2: { name: "아늑한 친환경 우드 하우스", emoji: "🏠", bg: "linear-gradient(135deg, #fef3c7, #fde68a)", floor: "#d97706" },
3: { name: "럭셔리 2층 통유리 궁전 케이지", emoji: "🏰", bg: "linear-gradient(135deg, #fae8ff, #f5d0fe)", floor: "#a855f7" }
};
const foodItems = [
{ id: "f1", name: "특선 해바라기씨", desc: "포만감 +15", price: 10, hunger: 15, happy: 5, icon: "🌻" },
{ id: "f2", name: "달콤 가득 딸기 슬라이스", desc: "포만감 +35, 행복 +15", price: 25, hunger: 35, happy: 15, icon: "🍓" },
{ id: "f3", name: "최고급 통치즈 덩어리", desc: "포만감 +60, 행복 +35", price: 50, hunger: 60, happy: 35, icon: "🧀" }
];
const hatItems = [
{ id: "h1", name: "귀여운 빨간 리본", price: 100, icon: "🎀" },
{ id: "h2", name: "미니 아기 황금 왕관", price: 300, icon: "👑" },
{ id: "h3", name: "신사 마술사 실크햇", price: 600, icon: "🎩" }
];
let currentShopTab = "food";
// 모달창 오픈 바인딩 및 버튼 수집
const startScreen = document.getElementById("start-screen");
const mainScreen = document.getElementById("main-screen");
const gameScreen = document.getElementById("game-screen");
const shopModal = document.getElementById("shop-modal");
const roomViewport = document.getElementById("room-viewport");
const room3DScene = document.getElementById("room-3d-scene");
// 🪐 마우스 움직임에 반응하는 3D 시점 카메라 회전 이펙트 구현
roomViewport.addEventListener("mousemove", (e) => {
const rect = roomViewport.getBoundingClientRect();
const x = e.clientX - rect.left - (rect.width / 2);
const y = e.clientY - rect.top - (rect.height / 2);
// 각도 제약 조건 연산 구현
const rotateX = 12 - (y / rect.height * 20);
const rotateY = (x / rect.width * 25);
room3DScene.style.transform = rotateX(${rotateX}deg) rotateY(${rotateY}deg);
});
roomViewport.addEventListener("mouseleave", () => {
room3DScene.style.transform = rotateX(12deg) rotateY(0deg);
});
// 🐹 종류 분양 카드 셀렉터
document.querySelectorAll(".type-card").forEach(card => {
card.addEventListener("click", () => {
document.querySelectorAll(".type-card").forEach(c => c.classList.remove("selected"));
card.classList.add("selected");
gameState.type = card.dataset.type;
gameState.emoji = card.dataset.emoji;
gameState.normalEmoji = card.dataset.emoji;
});
});
// 분양 및 게임 정식 론칭 스타트 트래커
document.getElementById("start-game-btn").addEventListener("click", () => {
const nameInput = document.getElementById("hamster-name-input").value.trim();
if(!nameInput) return alert("이름을 부여해주세요!");
gameState.name = nameInput;
document.getElementById("display-name").innerText = gameState.name;
document.getElementById("display-type").innerText = gameState.emoji;
document.getElementById("hamster-body").innerText = gameState.emoji;
if(gameState.type === 'golden') {
document.getElementById("hamster-body").style.filter = "sepia(0.6) hue-rotate(15deg) saturate(2)";
}
startScreen.classList.remove("active");
mainScreen.classList.add("active");
startCoreTimers();
});
// 다마고치 백그라운드 엔진 스케줄러 루프
function startCoreTimers() {
// 1. 주기적인 포만감과 감정 고갈 처리 시스템
setInterval(() => {
gameState.hunger = Math.max(0, gameState.hunger - 3);
gameState.happy = Math.max(0, gameState.happy - 2);
// 질병 검출 트리거 조건 판정
if((gameState.hunger <= 10 || gameState.happy <= 10) && !gameState.isSick) {
gameState.isSick = true;
showSpeech("콜록콜록.. 아파요 🏥 병원에 데려가주세요..");
}
updateMainUI();
}, 3000);
// 2. 쳇바퀴 실시간 자동 코인 누적기 시스템
setInterval(() => {
if(!gameState.isSick && gameState.hunger > 15 && gameState.happy > 15) {
gameState.gold += wheelData[gameState.wheelLevel].gold;
document.getElementById("wheel-object").classList.add("spinning");
} else {
document.getElementById("wheel-object").classList.remove("spinning");
}
updateMainUI();
}, 1000);
// 3. 자율 인공지능 보행 산책 패턴 구현
setInterval(() => {
if(!gameState.isSick) {
const walkX = Math.floor(Math.random() * 200) + 20;
document.getElementById("hamster-character").style.left = walkX + "px";
}
}, 5000);
}
// 실시간 UI 드로잉 동기화 갱신
function updateMainUI() {
document.getElementById("display-gold").innerText = gameState.gold.toLocaleString();
document.getElementById("hunger-bar").style.width = gameState.hunger + "%";
document.getElementById("happy-bar").style.width = gameState.happy + "%";
const condText = document.getElementById("condition-text");
const hamBody = document.getElementById("hamster-body");
const hospBtn = document.getElementById("menu-hospital-btn");
if(gameState.isSick) {
condText.innerText = "건강 상태: 매우 아픔! 😷";
condText.style.color = "#ef4444";
hamBody.innerText = "😷";
hospBtn.classList.add("pulse"); // 병원 버튼 반짝임 경고 이펙트 효과 활성화
} else {
hospBtn.classList.remove("pulse");
condText.style.color = "#ef4444";
if(gameState.hunger > 60 && gameState.happy > 60) {
condText.innerText = "건강 상태: 최고 😊";
condText.style.color = "#10b981";
hamBody.innerText = gameState.normalEmoji;
} else {
condText.innerText = "건강 상태: 보통 😐";
condText.style.color = "#64748b";
hamBody.innerText = gameState.normalEmoji;
}
}
// 가구 및 집 디자인 동기화
const w = wheelData[gameState.wheelLevel];
document.getElementById("wheel-object").innerText = w.emoji;
document.getElementById("wheel-object").style.cssText += w.style;
const h = houseData[gameState.houseLevel];
document.getElementById("house-object").innerText = h.emoji;
document.documentElement.style.setProperty('--room-bg', h.bg);
document.documentElement.style.setProperty('--floor-bg', h.floor);
}
// 👋 실시간 쓰다듬기 버튼 인터랙션 시스템
document.getElementById("menu-pet-btn").addEventListener("click", () => {
if(gameState.isSick) {
showSpeech("아파서 쓰다듬어도 기운이 안 나요.. 병원 먼저 가요 ㅠ");
return;
}
// 눈 감고 행복해하는 표정 렌더 유도 ( ⁠⁠´⁠꒳⁠`⁠⁠ ) 또는 웃는 아이콘 변형
const hamBody = document.getElementById("hamster-body");
hamBody.innerText = "🥰";
hamBody.style.transform = "scale(1.15)";
gameState.happy = Math.min(100, gameState.happy + 15);
// 3D 공간 하트 스폰 팝업 분출
for(let i=0; i<3; i++) {
setTimeout(() => {
const heart = document.createElement("div");
heart.className = "heart-effect";
heart.innerText = "❤️";
heart.style.left = (Math.random() * 40 + 25) + "px";
heart.style.top = (Math.random() * 20) + "px";
document.getElementById("hamster-character").appendChild(heart);
setTimeout(() => heart.remove(), 1000);
}, i * 200);
}
showSpeech("낑낑~ 기분 최고! 너무 좋아요 주인님!");
updateMainUI();
// 1.2초 후 다시 원래 얼굴 리셋 원복 처리
setTimeout(() => {
hamBody.style.transform = "scale(1)";
if(!gameState.isSick) hamBody.innerText = gameState.normalEmoji;
}, 1200);
});
// 🏥 동물병원 치료 프로세스
document.getElementById("menu-hospital-btn").addEventListener("click", () => {
if(!gameState.isSick) {
return alert("햄스터가 아주 건강합니다! 아플 때 방문해 주세요.");
}
if(gameState.gold >= 200) {
gameState.gold -= 200;
gameState.isSick = false;
gameState.hunger = Math.max(50, gameState.hunger);
gameState.happy = Math.max(50, gameState.happy);
alert("🏥 진료 완료! 의사 선생님의 치료로 주사를 맞고 건강을 완전히 되찾았습니다!");
