} else {
alert("치료비(200 🪙)가 부족합니다. 우측 초록색 미니게임을 플레이해서 골드를 벌어오세요!");
}
});
// 피딩 다이렉트 숏컷 게이트웨이
document.getElementById("menu-feed-btn").addEventListener("click", () => {
shopModal.style.display = "flex";
