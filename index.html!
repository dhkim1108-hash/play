function closeModal(id) { document.getElementById(id).style.display = "none"; }
function switchShopTab(tab) {
currentShopTab = tab;
document.getElementById("tab-food").classList.toggle("active", tab === "food");
document.getElementById("tab-upgrade").classList.toggle("active", tab === "upgrade");
renderShopUI();
}
// 상점 데이터 빌더 엔진
function renderShopUI() {
const list = document.getElementById("shop-item-list");
list.innerHTML = "";
if(currentShopTab === "food") {
foodItems.forEach(f => {
const card = document.createElement("div");
card.className = "item-card";
card.innerHTML = <div class="item-info"> <div class="item-icon">${f.icon}</div> <div class="item-details"> <div class="item-name">${f.name}</div> <div class="item-desc">${f.desc}</div> </div> </div> <div class="buy-action"> <span class="price-tag">🪙 ${f.price}</span> <button class="item-btn" onclick="buyFoodItem('${f.id}')">급여하기</button> </div>;
list.appendChild(card);
});
} else {
// 쳇바퀴 빌더 배치
const nWheel = gameState.wheelLevel + 1;
if(nWheel <= 4) {
let cost = nWheel === 2 ? 150 : nWheel === 3 ? 450 : 1000;
const card = document.createElement("div");
card.className = "item-card";
card.innerHTML = <div class="item-info"> <div class="item-icon">🎡</div> <div class="item-details"> <div class="item-name">${wheelData[nWheel].name}</div> <div class="item-desc">자동 생산 골드량 대폭 가속 업그레이드</div> </div> </div> <div class="buy-action"> <span class="price-tag">🪙 ${cost}</span> <button class="item-btn" onclick="upgradeWheelUnit(${cost})">업그레이드</button> </div>;
list.appendChild(card);
}
// 📦 햄스터 대형 집 케이지 강화 코너 빌드업
const nHouse = gameState.houseLevel + 1;
if(nHouse <= 3) {
let hCost = nHouse === 2 ? 300 : 800;
const card = document.createElement("div");
card.className = "item-card";
card.innerHTML = <div class="item-info"> <div class="item-icon">🏠</div> <div class="item-details"> <div class="item-name">${houseData[nHouse].name}</div> <div class="item-desc">3D 케이지 환경 테마 및 가구가 화려하게 교체</div> </div> </div> <div class="buy-action"> <span class="price-tag">🪙 ${hCost}</span> <button class="item-btn" style="background:#a855f7;" onclick="upgradeHouseUnit(${hCost})">집 리모델링</button> </div>;
list.appendChild(card);
}
// 의류 코디 소품 아이템 리스트업 출력
hatItems.forEach(h => {
const isOwn = gameState.ownedHats.includes(h.id);
const isEquip = gameState.equippedHat === h.id;
const card = document.createElement("div");
card.className = "item-card";
card.innerHTML = <div class="item-info"> <div class="item-icon">${h.icon}</div> <div class="item-details"> <div class="item-name">${h.name}</div> <div class="item-desc">${isOwn ? '보유장비 옷장보관' : '아바타 머리 장식 아이템'}</div> </div> </div> <div class="buy-action"> <span class="price-tag">${isOwn ? '구매완료' : '🪙 ' + h.price}</span> <button class="item-btn ${isOwn ? (isEquip ? 'equipped' : 'owned') : ''}" onclick="handleHatAction('${h.id}', ${h.price})"> ${isOwn ? (isEquip ? '모자벗기' : '착용하기') : '구매코디'} </button> </div>;
list.appendChild(card);
});
}
}
function buyFoodItem(id) {
const f = foodItems.find(item => item.id === id);
if(gameState.gold >= f.price) {
gameState.gold -= f.price;
gameState.hunger = Math.min(100, gameState.hunger + f.hunger);
gameState.happy = Math.min(100, gameState.happy + f.happy);
updateMainUI();
showSpeech(오물오물 냠냠! ${f.name} 최고! 😋);
renderShopUI();
} else { alert("코인이 부족해요! 미니게임을 뛰어주세요!"); }
}
function upgradeWheelUnit(cost) {
if(gameState.gold >= cost) {
gameState.gold -= cost;
gameState.wheelLevel++;
updateMainUI();
showSpeech("와! 쳇바퀴가 부드러워져서 골드가 복사돼요! 🎡");
renderShopUI();
} else { alert("골드가 모자랍니다."); }
}
// 🏠 케이지 럭셔리 하우스 업그레이드 트랙션
function upgradeHouseUnit(cost) {
if(gameState.gold >= cost) {
gameState.gold -= cost;
gameState.houseLevel++;
updateMainUI();
showSpeech("우와아아! 우리 집이 3D 궁전으로 탈바꿈했어요! ✨🏰✨");
renderShopUI();
} else { alert("리모델링 코인이 부족합니다."); }
}
function handleHatAction(id, price) {
const isOwn = gameState.ownedHats.includes(id);
if(!isOwn) {
if(gameState.gold >= price) {
gameState.gold -= price;
gameState.ownedHats.push(id);
gameState.equippedHat = id;
document.getElementById("hamster-hat").innerText = hatItems.find(h => h.id === id).icon;
alert("성공적으로 코디 소품을 구입하여 즉시 장착했습니다!");
} else { alert("코인이 부족합니다."); }
} else {
if(gameState.equippedHat === id) {
gameState.equippedHat = null;
document.getElementById("hamster-hat").innerText = "";
} else {
gameState.equippedHat = id;
document.getElementById("hamster-hat").innerText = hatItems.find(h => h.id === id).icon;
}
}
updateMainUI();
renderShopUI();
}
function showSpeech(txt) {
const b = document.getElementById("speech-bubble");
b.innerText = txt; b.style.display = "block";
setTimeout(() => b.style.display = "none", 2500);
}
// ==========================================
// --- 미니게임 파트 (해바라기 낙하 통제 액션) ---
// ==========================================
const canvas = document.getElementById("game-canvas");
const ctx = canvas.getContext("2d");
let miniGameActive = false, score = 0, timeLeft = 30;
let gameInterval, animFrameId;
const player = { x: 180, y: 0, width: 70, height: 70 };
let items = [];
document.getElementById("menu-game-btn").addEventListener("click", () => {
if(gameState.isSick) {
return alert("햄스터가 병이 들어 미니게임을 뛸 수 없습니다! 먼저 동물병원 치료부터 진행해 주세요.");
}
mainScreen.classList.remove("active");
gameScreen.classList.add("active");
canvas.width = gameScreen.clientWidth; canvas.height = gameScreen.clientHeight;
miniGameActive = true; score = 0; timeLeft = 30; items = [];
player.x = canvas.width / 2 - player.width / 2;
player.y = canvas.height - 110;
document.getElementById("game-score").innerText = score;
gameInterval = setInterval(() => {
timeLeft--;
document.getElementById("game-timer").innerText = 시간: ${timeLeft}초;
if(timeLeft <= 0) endMiniGame();
}, 1000);
canvas.addEventListener("mousemove", movePlayer);
gameLoop();
});
function movePlayer(e) {
const r = canvas.getBoundingClientRect();
player.x = (e.clientX - r.left) - player.width / 2;
if(player.x < 0) player.x = 0;
if(player.x > canvas.width - player.width) player.x = canvas.width - player.width;
}
function gameLoop() {
if(!miniGameActive) return;
ctx.clearRect(0,0,canvas.width,canvas.height);
// 배경 그리기
ctx.fillStyle = "#bae6fd"; ctx.fillRect(0,0,canvas.width,canvas.height);
ctx.fillStyle = "#a7f3d0"; ctx.fillRect(0, canvas.height - 50, canvas.width, 50);
if(Math.random() < 0.05) {
const isSeed = Math.random() < 0.75;
items.push({
x: Math.random() * (canvas.width - 40) + 20,
y: -20,
type: isSeed ? "seed" : "pepper",
speed: Math.random() * 3 + 4 + (30 - timeLeft)*0.2
});
}
for(let i = items.length-1; i>=0; i--) {
let it = items[i]; it.y += it.speed;
ctx.font = "32px Arial"; ctx.textAlign = "center";
ctx.fillText(it.type === "seed" ? "🌻" : "🌶️", it.x, it.y);
// 바운딩 박스 오버랩 히트 테스트 판정
if(it.y >= player.y && it.y <= player.y + player.height && it.x >= player.x && it.x <= player.x + player.width) {
if(it.type === "seed") score++;
else score = Math.max(0, score - 3);
document.getElementById("game-score").innerText = score;
items.splice(i, 1);
continue;
}
if(it.y > canvas.height) items.splice(i,1);
}
// 아바타 플레이어 스킨 투사 렌더
ctx.font = "60px Arial"; ctx.textAlign = "left";
if(gameState.type === 'golden') ctx.filter = "sepia(0.6) hue-rotate(15deg) saturate(2)";
ctx.fillText(gameState.normalEmoji, player.x, player.y);
ctx.filter = "none";
if(gameState.equippedHat) {
ctx.font = "28px Arial";
ctx.fillText(hatItems.find(h=>h.id === gameState.equippedHat).icon, player.x + 12, player.y - 12);
}
animFrameId = requestAnimationFrame(gameLoop);
}
function endMiniGame() {
miniGameActive = false;
clearInterval(gameInterval);
cancelAnimationFrame(animFrameId);
canvas.removeEventListener("mousemove", movePlayer);
// 환산 정산 연산 처리식
const bonusGold = score * 20;
gameState.gold += bonusGold;
gameState.happy = Math.min(100, gameState.happy + 30);
gameState.hunger = Math.max(20, gameState.hunger - 15); // 체력 소모로 배고파짐 반영
alert(🎮 타임아웃! 게임 종료! \n수확한 해바라기씨: ${score}개 \n💰 정산 획득 코인: +${bonusGold} 🪙 \n활동으로 인해 행복해졌지만 조금 배가 고파졌습니다!);
gameScreen.classList.remove("active");
mainScreen.classList.add("active");
updateMainUI();
}


