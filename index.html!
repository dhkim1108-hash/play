<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D 햄스터의 다마고치 월드</title>
    <style>
        :root {
            --bg-color: #f0f4f8;
            --main-dark: #f6416c;
            --room-bg: linear-gradient(135deg, #e0f2fe, #bae6fd);
            --floor-bg: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
            user-select: none;
        }

        body {
            background-color: #1e293b;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            perspective: 1000px; /* 3D 효과를 위한 원근감 설정 */
        }

        #game-container {
            width: 450px;
            height: 780px;
            background-color: var(--bg-color);
            border: 8px solid #334155;
            border-radius: 35px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .screen {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            display: none;
            flex-direction: column;
            padding: 20px;
        }

        .screen.active {
            display: flex;
        }

        /* 1. 시작 화면 */
        #start-screen {
            justify-content: center;
            align-items: center;
            background: linear-gradient(to bottom, #ffecd2 0%, #fcb69f 100%);
            text-align: center;
        }

        h1 {
            font-size: 26px;
            color: #c2410c;
            margin-bottom: 25px;
            text-shadow: 2px 2px 0px #fff;
        }

        .input-group {
            margin-bottom: 25px;
            width: 100%;
        }

        .input-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            color: #ea580c;
        }

        .input-group input {
            width: 80%;
            padding: 12px;
            border: 3px solid #ea580c;
            border-radius: 15px;
            font-size: 16px;
            text-align: center;
            outline: none;
        }

        .type-selector {
            display: flex;
            justify-content: space-around;
            width: 100%;
            margin-bottom: 35px;
        }

        .type-card {
            background: white;
            border: 3px solid #cbd5e1;
            border-radius: 15px;
            padding: 10px;
            width: 28%;
            cursor: pointer;
            transition: all 0.2s;
        }

        .type-card.selected {
            border-color: var(--main-dark);
            background-color: #fff0f2;
            transform: scale(1.05);
        }

        .type-card .emoji {
            font-size: 40px;
            display: block;
            margin-bottom: 5px;
        }

        .type-card .name {
            font-size: 12px;
            font-weight: bold;
        }

        .btn {
            background-color: var(--main-dark);
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 5px 0px #b81d40;
        }

        .btn:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0px #b81d40;
        }

        /* 2. 메인 화면 */
        #main-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 10px 15px;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            z-index: 5;
        }

        #hamster-info { font-weight: bold; }
        #gold-display { font-weight: bold; color: #d97706; font-size: 18px; }

        #status-bars {
            margin-top: 12px;
            background: rgba(255,255,255,0.8);
            padding: 12px;
            border-radius: 15px;
            z-index: 5;
        }

        .stat-row { display: flex; align-items: center; margin-bottom: 6px; }
        .stat-row:last-child { margin-bottom: 0; }
        .stat-label { width: 65px; font-size: 12px; font-weight: bold; }
        .bar-container { flex-grow: 1; height: 12px; background-color: #cbd5e1; border-radius: 6px; overflow: hidden; }
        .bar { height: 100%; width: 100%; transition: width 0.3s; }
        #hunger-bar { background-color: #10b981; }
        #happy-bar { background-color: #3b82f6; }
        #condition-text { font-size: 12px; font-weight: bold; text-align: right; color: #ef4444; width: 100%; margin-top: 2px; }

        /* 🪐 3D 그래픽 룸 환경 레이아웃 */
        #room-viewport {
            flex-grow: 1;
            margin: 15px 0;
            overflow: hidden;
            border-radius: 20px;
            background: #0f172a;
            perspective: 800px; /* 깊이 원근감 */
        }

        #room-3d-scene {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transform: rotateX(12deg) rotateY(0deg);
            transition: transform 0.1s ease-out;
        }

        /* 3D 벽면과 바닥 */
        #room-back-wall {
            position: absolute;
            width: 100%;
            height: 85%;
            background: var(--room-bg);
            transform: translateZ(-100px);
            border-bottom: 4px solid #94a3b8;
        }

        #room-floor {
            position: absolute;
            width: 100%;
            height: 250px;
            bottom: -50px;
            background: var(--floor-bg);
            transform: rotateX(80deg);
            transform-origin: bottom center;
            box-shadow: inset 0 50px 100px rgba(0,0,0,0.1);
        }

        /* 3D 가구 및 오브젝트 배치 */
        #wheel-object {
            position: absolute;
            bottom: 110px;
            right: 40px;
            font-size: 90px;
            width: 100px;
            height: 100px;
            transform: translateZ(-20px);
            display: flex;
            justify-content: center;
            align-items: center;
            filter: drop-shadow(0 15px 10px rgba(0,0,0,0.15));
        }

        .spinning { animation: spin 0.8s linear infinite; }
        @keyframes spin { 100% { transform: rotate(-360deg); } }

        #house-object {
            position: absolute;
            bottom: 120px;
            left: 30px;
            font-size: 75px;
            transform: translateZ(-40px);
            filter: drop-shadow(0 10px 8px rgba(0,0,0,0.15));
        }

        /* 🐹 3D 캐릭터 래퍼 */
        #hamster-character {
            position: absolute;
            bottom: 90px;
            left: 160px;
            width: 90px;
            height: 90px;
            transform-style: preserve-3d;
            transform: translateZ(20px);
            transition: left 0.6s ease-out;
            cursor: pointer;
        }

        #hamster-body-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #hamster-body { font-size: 70px; z-index: 2; transition: transform 0.2s; }
        #hamster-hat { position: absolute; top: -10px; font-size: 35px; z-index: 4; width: 100%; text-align: center; pointer-events: none; }
        
        /* 말풍선 */
        #speech-bubble {
            position: absolute;
            top: -55px;
            left: 50%;
            transform: translateX(-50%) translateZ(30px);
            background: white;
            padding: 6px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            border: 2px solid #333;
            display: none;
            white-space: nowrap;
            z-index: 10;
        }

        /* 하트 이펙트 효과 */
        .heart-effect {
            position: absolute;
            color: #ff4d6d;
            font-size: 24px;
            animation: floatUp 1s ease-out forwards;
            pointer-events: none;
            z-index: 100;
        }
        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.5); opacity: 1; }
            100% { transform: translateY(-60px) scale(1.3); opacity: 0; }
        }

        /* 하단 메뉴 바 */
        #footer-menu { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
        .menu-btn {
            background: white;
            border: 2px solid #cbd5e1;
            padding: 10px 0;
            border-radius: 15px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            font-size: 11px;
        }
        .menu-btn .icon { font-size: 20px; }
        .menu-btn:active { background-color: #f1f5f9; }
        .menu-btn.pulse { animation: alertPulse 1.5s infinite; background: #fee2e2; border-color: #ef4444; }
        @keyframes alertPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }

        /* 3. 모달/팝업 공통 스타일 */
        .modal {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.6);
            z-index: 100;
            justify-content: flex-end;
            flex-direction: column;
        }

        .modal-content {
            background: white;
            border-top-left-radius: 25px;
            border-top-right-radius: 25px;
            height: 65%;
